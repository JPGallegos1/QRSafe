# Secreto del webhook de Kapso. Con esto se verifica la firma HMAC SHA256 que
# llega en X-Webhook-Signature. Sin esto configurado el endpoint rechaza TODO,
# que es el comportamiento correcto: un webhook sin verificar es un endpoint
# público que descarga URLs ajenas y manda mensajes a cuenta de uno.
WEBHOOK_SECRET=

# Clave del proyecto en Kapso, para responder por el proxy de Meta.
# Ojo: NO se usa para descargar la imagen. Ese blob se sirve sin credencial, y
# su redirect cruza de host, así que mandar la clave se la entregaría al storage.
KAPSO_API_KEY=

# Base del proxy de Meta. Sólo hace falta cambiarla para apuntar a otro entorno.
# KAPSO_API_BASE=https://api.kapso.ai/meta/whatsapp/v24.0

# PORT=3000
