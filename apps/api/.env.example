# Kapso webhook secret. It verifies the HMAC SHA256 signature sent in
# X-Webhook-Signature. Without it, the endpoint rejects every request. That is
# correct: an unverified webhook can download arbitrary URLs and send messages
# at our expense.
WEBHOOK_SECRET=

# Kapso project key used to reply through the Meta proxy.
# Do NOT use it to download the image. That blob is served without credentials,
# and its cross-host redirect would leak the key to storage.
KAPSO_API_KEY=

# Meta proxy base URL. Change it only to point at another environment.
# KAPSO_API_BASE=https://api.kapso.ai/meta/whatsapp/v24.0

# PORT=3000

# Supabase is used only by apps/api. Never expose the secret key to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Exact browser origin allowed to call the API. Server-to-server requests do not
# send Origin and are not affected by CORS.
ADMIN_ORIGIN=http://localhost:5174

# MVP verification switch. true approves a submitted business immediately.
DEMO_AUTO_APPROVE=false

# Hackathon-only auth switch. true creates confirmed users so the recorded flow
# does not leave the panel to open an email. Keep false outside the demo.
DEMO_AUTO_CONFIRM_EMAIL=false
