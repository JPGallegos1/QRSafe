{
  "name": "@qrsafe/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit --pretty false",
    "dev": "npm --workspace @qrsafe/verification run build && tsx watch src/server.ts",
    "lint": "oxlint src",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@qrsafe/verification": "*",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
